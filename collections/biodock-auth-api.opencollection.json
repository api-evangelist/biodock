{
  "opencollection": "1.0.0",
  "info": {
    "name": "Biodock Public Analysis Jobs Auth API",
    "version": "1.0.0-beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.biodock.ai/api/external/check"
          },
          "docs": "Verify that the provided API key is valid and return the associated user."
        }
      ]
    }
  ],
  "bundled": true
}