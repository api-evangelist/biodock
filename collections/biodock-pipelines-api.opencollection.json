{
  "opencollection": "1.0.0",
  "info": {
    "name": "Biodock Public Analysis Jobs Pipelines API",
    "version": "1.0.0-beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pipelines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List pipelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.biodock.ai/api/external/pipelines",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to show."
              },
              {
                "name": "startingAfter",
                "value": "",
                "type": "query",
                "description": "Pagination cursor id (id of the last item on the previous page)."
              }
            ]
          },
          "docs": "List your active, published analysis pipelines."
        }
      ]
    }
  ],
  "bundled": true
}